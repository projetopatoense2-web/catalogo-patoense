# ══════════════════════════════════════════════════════════════════
#  NETLIFY _headers — Distribuidora Patoense 2026
#  Hardening de segurança HTTP para todas as rotas
# ══════════════════════════════════════════════════════════════════

/*
  # ── Força HTTPS e mantém por 1 ano com subdomínios ──
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # ── Impede que a página seja carregada em iframe (clickjacking) ──
  X-Frame-Options: DENY

  # ── Impede que o browser "adivinhe" o tipo MIME ──
  X-Content-Type-Options: nosniff

  # ── Não envia o Referer ao navegar para outro domínio ──
  Referrer-Policy: strict-origin-when-cross-origin

  # ── Restringe acesso a APIs do browser desnecessárias ──
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # ── Content Security Policy ──
  # Permite:
  #   - Scripts: apenas self, Firebase SDK (gstatic) e inline necessário
  #   - Estilos: self, inline (necessário p/ componentes JS), Google Fonts
  #   - Fontes: apenas Google Fonts CDN
  #   - Conexões: Firebase REST, WebSocket e Firestore
  #   - Imagens: self, data URIs e blobs (para imagens de produtos)
  #   - Frames: nenhum
  #   - Objetos/embeds: nenhum
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src https://fonts.gstatic.com; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com https://firestore.googleapis.com wss://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; img-src 'self' data: blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self';

  # ── Cross-Origin Resource Policy ──
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# ── Cache seguro para HTML: nunca cachear (sempre fresco) ──
/*.html
  Cache-Control: no-store, no-cache, must-revalidate

# ── Cache longo para assets estáticos com hash no nome ──
/images/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=86400

# ── Bloqueia acesso a arquivos sensíveis ──
/.env
  X-Robots-Tag: noindex
  Cache-Control: no-store

/firebase.json
  X-Robots-Tag: noindex
  Cache-Control: no-store

/firestore.rules
  X-Robots-Tag: noindex
  Cache-Control: no-store
